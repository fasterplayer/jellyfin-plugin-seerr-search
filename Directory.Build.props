<Project>
  <PropertyGroup>
    <!-- Shared by the assembly, the file and the package.
         Keep in sync with build.yaml; the release workflow checks it against the tag. -->
    <Version>1.3.0.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <Authors>fasterplayer</Authors>
    <Company>fasterplayer</Company>
    <Copyright>Copyright © 2026 fasterplayer</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/fasterplayer/jellyfin-plugin-seerr-search</RepositoryUrl>
  </PropertyGroup>
</Project>